-- language: Luau
-- Red/Black Aimbot + GUI — loadstring-ready
-- Aim: hold RightMouseButton → camera locks to nearest visible player head
-- Theme: #0a0a0a bg, #c8102e accents

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local Workspace         = game:GetService("Workspace")
local Camera            = Workspace.CurrentCamera
local LocalPlayer       = Players.LocalPlayer

-- ============ CONFIG ============
local CONFIG = {
    enabled       = true,
    aim_key       = Enum.UserInputType.MouseButton2,  -- right mouse
    fov           = 150,          -- pixels, screen-space
    smoothness    = 0.18,         -- 0 = instant snap, 1 = slow. keep >0.1 to look human
    max_distance  = 500,          -- studs. skip targets further than this
    wall_check    = true,         -- raycast before aiming
    team_check    = true,
    fov_circle    = true,
    bg            = Color3.fromRGB(10, 10, 10),
    accent        = Color3.fromRGB(200, 16, 46),
    text          = Color3.fromRGB(240, 240, 240),
    dim           = Color3.fromRGB(60, 60, 60),
}

-- ============ STATE ============
local state = {
    holding   = false,
    target    = nil,
    gui       = nil,
    conns     = {},
}

-- ============ GUI (red/black floating) ============
local function build_gui()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "RB_Aim"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.Parent = (getgenv and getgenv().gethui and getgenv().gethui()) or game:GetService("CoreGui")

    local main = Instance.new("Frame")
    main.Name = "Main"
    main.Size = UDim2.fromOffset(260, 170)
    main.Position = UDim2.new(1, -290, 0, 20)
    main.BackgroundColor3 = CONFIG.bg
    main.BorderSizePixel = 0
    main.Active = true
    main.Draggable = true
    main.Parent = ScreenGui

    local stroke = Instance.new("UIStroke")
    stroke.Color = CONFIG.accent
    stroke.Thickness = 1.5
    stroke.Parent = main

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = main

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 34)
    title.BackgroundColor3 = CONFIG.accent
    title.BackgroundTransparency = 0
    title.BorderSizePixel = 0
    title.Text = "  RB · AIM"
    title.TextColor3 = CONFIG.text
    title.Font = Enum.Font.Code
    title.TextSize = 15
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = main
    Instance.new("UICorner", title).CornerRadius = UDim.new(0, 6)

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.fromOffset(200, 34)
    toggle.Position = UDim2.fromOffset(30, 50)
    toggle.BackgroundColor3 = CONFIG.accent
    toggle.BorderSizePixel = 0
    toggle.Font = Enum.Font.Code
    toggle.TextSize = 14
    toggle.TextColor3 = CONFIG.text
    toggle.Text = "ENABLED"
    toggle.Parent = main
    Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 4)

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -60, 0, 18)
    status.Position = UDim2.fromOffset(30, 92)
    status.BackgroundTransparency = 1
    status.Font = Enum.Font.Code
    status.TextSize = 12
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.TextColor3 = CONFIG.dim
    status.Text = "hold RMB · fov 150 · smooth 0.18"
    status.Parent = main

    local hint = Instance.new("TextLabel")
    hint.Size = UDim2.new(1, -60, 0, 16)
    hint.Position = UDim2.fromOffset(30, 112)
    hint.BackgroundTransparency = 1
    hint.Font = Enum.Font.Code
    hint.TextSize = 11
    hint.TextXAlignment = Enum.TextXAlignment.Left
    hint.TextColor3 = CONFIG.dim
    hint.Text = "right-mouse = aim · LeftCtrl = panic off"
    hint.Parent = main

    local target_lbl = Instance.new("TextLabel")
    target_lbl.Size = UDim2.new(1, -60, 0, 16)
    target_lbl.Position = UDim2.fromOffset(30, 132)
    target_lbl.BackgroundTransparency = 1
    target_lbl.Font = Enum.Font.Code
    target_lbl.TextSize = 11
    target_lbl.TextXAlignment = Enum.TextXAlignment.Left
    target_lbl.TextColor3 = CONFIG.accent
    target_lbl.Text = "target: —"
    target_lbl.Parent = main

    toggle.MouseButton1Click:Connect(function()
        CONFIG.enabled = not CONFIG.enabled
        toggle.Text = CONFIG.enabled and "ENABLED" or "DISABLED"
        toggle.BackgroundColor3 = CONFIG.enabled and CONFIG.accent or CONFIG.dim
    end)

    state.gui = { screen = ScreenGui, main = main, toggle = toggle, target = target_lbl }
end

-- ============ HELPERS ============
local function is_alive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function get_head(plr)
    local char = plr.Character
    if not char then return nil end
    return char:FindFirstChild("Head")
end

local function in_same_team(plr)
    if not CONFIG.team_check then return false end
    if not LocalPlayer.Team then return false end
    return plr.Team == LocalPlayer.Team
end

local function visible(head)
    if not CONFIG.wall_check then return true end
    local origin = Camera.CFrame.Position
    local dir = (head.Position - origin)
    if dir.Magnitude > CONFIG.max_distance then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
    local hit = Workspace:Raycast(origin, dir, params)
    return hit == nil or hit.Instance:IsDescendantOf(head.Parent)
end

local function world_to_screen(pos)
    local vp = Camera.ViewportSize
    local sp, on = Camera:WorldToViewportPoint(pos)
    if not on then return nil end
    return Vector2.new(sp.X, sp.Y)
end

local function screen_distance(a, b)
    return (Vector2.new(a.X, a.Y) - Vector2.new(b.X, b.Y)).Magnitude
end

local function pick_target()
    local best, best_dist = nil, CONFIG.fov
    local center = Camera.ViewportSize / 2
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and is_alive(plr) and not in_same_team(plr) then
            local head = get_head(plr)
            if head and visible(head) then
                local sp = world_to_screen(head.Position)
                if sp then
                    local d = screen_distance(sp, center)
                    if d < best_dist then
                        best, best_dist = head, d
                    end
                end
            end
        end
    end
    return best
end

-- ============ AIM LOOP ============
local function on_render(dt)
    if not CONFIG.enabled or not state.holding then return end
    if not LocalPlayer.Character or not is_alive(LocalPlayer) then return end
    if not Camera then return end

    local head = pick_target()
    if not head then
        if state.gui then state.gui.target.Text = "target: —" end
        return
    end

    if state.gui then state.gui.target.Text = "target: " .. head.Parent.Name end

    local goal = CFrame.lookAt(Camera.CFrame.Position, head.Position)
    local alpha = math.clamp(1 - CONFIG.smoothness, 0.01, 1)
    Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
end

-- ============ INPUT ============
local function bind()
    table.insert(state.conns, UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == CONFIG.aim_key then
            state.holding = true
        elseif input.KeyCode == Enum.KeyCode.LeftControl then
            CONFIG.enabled = false
            if state.gui then
                state.gui.toggle.Text = "DISABLED"
                state.gui.toggle.BackgroundColor3 = CONFIG.dim
            end
        end
    end))
    table.insert(state.conns, UserInputService.InputEnded:Connect(function(input, gpe)
        if input.UserInputType == CONFIG.aim_key then
            state.holding = false
        end
    end))
end

-- ============ CLEANUP / START ============
local function cleanup()
    for _, c in ipairs(state.conns) do
        if c and c.Disconnect then pcall(function() c:Disconnect() end) end
    end
    state.conns = {}
    if state.gui and state.gui.screen then
        pcall(function() state.gui.screen:Destroy() end)
    end
    state.gui = nil
end

if getgenv().RB_AIM_CLEANUP then pcall(getgenv().RB_AIM_CLEANUP) end
getgenv().RB_AIM_CLEANUP = cleanup

build_gui()
bind()
RunService:BindToRenderStep("RB_AIM", Enum.RenderPriority.Camera.Value + 1, on_render)

print("[RB_AIM] loaded — hold RMB to aim, LeftCtrl to panic-off")
